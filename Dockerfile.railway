# Railway build of Agent Vault.
#
# Identical to ./Dockerfile except that it drops the `VOLUME` instruction,
# which Railway rejects ("use Railway Volumes"). Persistence comes from a
# Railway Volume mounted at /data instead; the service also needs
# RAILWAY_RUN_UID=0, since that volume is mounted root-owned and the image's
# unprivileged user cannot create /data/.agent-vault under it.
#
# Both listeners bind `::`, which Go opens as a dual-stack socket
# (IPV6_V6ONLY=0), so they accept IPv4 from Railway's public edge and TCP
# proxy *and* IPv6 from Railway's private network. In-project agents can
# therefore reach both the API and the MITM proxy on the same host,
# <service>.railway.internal, which is what `agent-vault run` assumes.
# This needs the net.JoinHostPort fix in cmd/server.go.

# ---- Frontend build ----
FROM node:26-alpine@sha256:e88a35be04478413b7c71c455cd9865de9b9360e1f43456be5951032d7ac1a66 AS frontend

WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ .
RUN npm run build

# ---- Go build stage ----
FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS builder

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
ARG POSTHOG_API_KEY=

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /internal/server/webdist /src/internal/server/webdist
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w \
    -X github.com/Infisical/agent-vault/cmd.version=${VERSION} \
    -X github.com/Infisical/agent-vault/cmd.commit=${COMMIT} \
    -X github.com/Infisical/agent-vault/cmd.date=${BUILD_DATE} \
    -X github.com/Infisical/agent-vault/cmd.posthogAPIKey=${POSTHOG_API_KEY}" \
    -o /agent-vault .

# ---- Runtime stage ----
FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk add --no-cache ca-certificates \
    && addgroup -S agentvault && adduser -S -G agentvault -u 65532 agentvault \
    && mkdir -p /data/.agent-vault && chown -R agentvault:agentvault /data

COPY --from=builder /agent-vault /usr/local/bin/agent-vault
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENV HOME=/data
EXPOSE 14321
EXPOSE 14322
USER agentvault

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["server", "--host", "::", "--port", "14321"]
